# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4
# Matches max_width in rustfmt.toml, so the editor ruler and the gate agree.
max_line_length = 79

[*.{toml,md,yml,yaml,json}]
indent_style = space
indent_size = 2

[justfile]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
# Prose is one line per paragraph; an editor hard-wrapping it would fight that.
max_line_length = off
